# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require "date"

default_platform(:ios)

platform :ios do
  desc "Run test coverage"
  lane :code_coverage do
    FileUtils.remove_dir "../xcov_output", true
    scan(
      scheme: ENV["APP_SCHEME"],
      code_coverage: true,
      fail_build: false,
      result_bundle: true,
      output_directory: "xcov_output",
      xcargs: "-skipPackagePluginValidation -skipMacroValidation"
    )
    xcov(
      project: ENV["APP_PROJECT"],
      scheme: ENV["APP_SCHEME"],
      output_directory: "xcov_output",
      ignore_file_path: "fastlane/.xcovignore",
      exclude_targets: ENV["XCOV_EXCLUDE_TARGETS"],
    )
  end

  desc "Run tests"
  lane :tests do |values|
    scheme = values[:scheme]
    scheme = ENV["APP_SCHEME"] if scheme.to_s.strip.empty?
    UI.user_error!("Missing required parameter: scheme (pass scheme: or set ENV[\"APP_SCHEME\"])") if scheme.to_s.strip.empty?
    scan(
      scheme: scheme,
      xcargs: "-skipPackagePluginValidation -skipMacroValidation"
    )
  end

  desc "Build & Deploy Wallet"
  lane :deploy do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "600"

    unless sh("git", "status", "--porcelain", "--untracked-files=no", log: false).strip.empty?
      UI.user_error!("Commit or stash the changes to tracked files first: deploy builds and tags HEAD, and restores the .pbxproj and .plist files from Git when it ends.")
    end

    browserstackEnabled = check_browserstack

    git_pull

    connect_api = app_store_connect_api_key(
      key_id: ENV["CONNECT_KEY_ID"],
      issuer_id: ENV["CONNECT_ISSUER_ID"],
      key_filepath: ENV["CONNECT_KEY_PATH"],
      duration: 1200,
      in_house: false,
    )

    latestBuildNumber = latest_testflight_build_number(
      api_key: connect_api,
      initial_build_number: 0,
    )

    buildNumber = build_number(versionBuildNumber: latestBuildNumber)

    fullVersion = full_version(
      buildType: ENV["APP_BUILD_TYPE"],
      buildCode: buildNumber,
    )

    minified_version(
      targets: ENV["APP_TARGETS"],
      configName: ENV["APP_VERSION_CONFIG"],
      fullVersion: fullVersion,
    )

    update_build_number(
      targets: ENV["APP_TARGETS"],
      number: buildNumber,
    )

    tagVersion = tag_name(
      buildName: fullVersion,
      buildNumber: buildNumber,
      brand: ENV["APP_TAG"],
      buildType: ENV["APP_BUILD_TYPE"],
    )

    build_app(
      scheme: ENV["APP_SCHEME"],
      include_bitcode: true,
      xcargs: "-skipPackagePluginValidation -skipMacroValidation",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          ENV["APP_BUNDLE_ID"] => ENV["APP_PROVISION_PROFILE"],
        },
      },
    )

    upload_appstore(
      connectApi: connect_api,
      binaryName: ENV["APP_IPA_PATH"],
      bundleId: ENV["APP_BUNDLE_ID"],
      groups: ENV["TESTFLIGHT_GROUPS"]
    )

    reset_project

    if browserstackEnabled
      upload_browserstack(
        filePath: ENV["APP_IPA_PATH"],
      )
    else
      UI.important("BrowserStack upload skipped: BROWSERSTACK_USERNAME and BROWSERSTACK_ACCESS_KEY are not set.")
    end

    clean_build_artifacts

    add_git_tag(
      tag: tagVersion,
    )

    if ENV['PROD_REMOTE_REPO']
      upload_tag(
        remoteUrl: ENV['PROD_REMOTE_REPO'],
        tag: tagVersion
      )
    end

    if ENV['DEV_REMOTE_REPO']
      upload_tag(
        remoteUrl: ENV['DEV_REMOTE_REPO'],
        tag: tagVersion,
      )
    end

    if ENV['GITHUB_RELEASE_REPO'] && ENV['GITHUB_RELEASE_TOKEN']
      github_release(
        token: ENV['GITHUB_RELEASE_TOKEN'],
        repo: ENV['GITHUB_RELEASE_REPO'],
        tag: tagVersion,
        version: fullVersion
      )
    end
  
  end

  desc "Release to github"
  lane :github_release do |values|
    token = values[:token]
    repo = values[:repo]
    tag = values[:tag]
    version = values[:version]
    github_release = set_github_release(
      repository_name: repo,
      api_token: token,
      name: version,
      tag_name: tag,
      is_generate_release_notes: true
    )
  end

  desc "Upload tag to remote repo"
  lane :upload_tag do |values|
    remoteUrl = values[:remoteUrl]
    tag = values[:tag]
    sh("git remote set-url origin #{remoteUrl}")
    push_git_tags(tag: tag)
  end

  desc "Upload IPA to TestFlight"
  lane :upload_appstore do |values|
    connectApi = values[:connectApi]
    binaryName = values[:binaryName]
    bundleId = values[:bundleId]
    groups = values[:groups]
    pilot(
      app_identifier: bundleId,
      api_key: connectApi,
      ipa: binaryName,
      skip_submission: false,
      skip_waiting_for_build_processing: true,
      groups: groups&.split(',')&.map(&:strip)
    )
  end

  desc "Check the BrowserStack settings: false when the upload is not configured, an error when it is only partly configured"
  lane :check_browserstack do
    username = ENV["BROWSERSTACK_USERNAME"].to_s.strip
    accessKey = ENV["BROWSERSTACK_ACCESS_KEY"].to_s.strip
    if username.empty? && accessKey.empty?
      false
    else
      missing = []
      missing << "BROWSERSTACK_USERNAME" if username.empty?
      missing << "BROWSERSTACK_ACCESS_KEY" if accessKey.empty?
      missing << "BROWSERSTACK_CUSTOM_ID" if ENV["BROWSERSTACK_CUSTOM_ID"].to_s.strip.empty?
      unless ["true", "false"].include?(ENV["BROWSERSTACK_IOS_KEYCHAIN_SUPPORT"].to_s.strip.downcase)
        missing << "BROWSERSTACK_IOS_KEYCHAIN_SUPPORT (true or false)"
      end
      unless missing.empty?
        UI.user_error!("The BrowserStack upload is only partly configured. Set #{missing.join(", ")}, or leave BROWSERSTACK_USERNAME and BROWSERSTACK_ACCESS_KEY empty to skip it.")
      end
      true
    end
  end

  desc "Upload IPA to BrowserStack App Automate"
  lane :upload_browserstack do |values|
    unless check_browserstack
      UI.user_error!("Set BROWSERSTACK_USERNAME, BROWSERSTACK_ACCESS_KEY, BROWSERSTACK_CUSTOM_ID and BROWSERSTACK_IOS_KEYCHAIN_SUPPORT to upload to BrowserStack.")
    end
    filePath = values[:filePath] || ENV["APP_IPA_PATH"]
    upload_to_browserstack_app_automate(
      browserstack_username: ENV["BROWSERSTACK_USERNAME"].to_s.strip,
      browserstack_access_key: ENV["BROWSERSTACK_ACCESS_KEY"].to_s.strip,
      file_path: filePath,
      custom_id: ENV["BROWSERSTACK_CUSTOM_ID"].to_s.strip,
      ios_keychain_support: ENV["BROWSERSTACK_IOS_KEYCHAIN_SUPPORT"].to_s.strip.downcase
    )
  end

  desc "Reset default project settings"
  lane :reset_project do
    sh("git", "checkout", "--", ":/*.pbxproj", ":/*.plist")
  end

  desc "Set build number"
  lane :update_build_number do |values|
    targets = values[:targets]
    number = values[:number]

    targets.split(",").map(&:strip).reject(&:empty?).each do |target|
      increment_build_number_in_plist(
        target: target,
        build_number: number.to_s,
      )

      increment_build_number_in_xcodeproj(
        target: target,
        build_number: number.to_s,
      )
    end
  end

  desc "Set version"
  lane :update_version do |values|
    targets = values[:targets]
    configName = values[:configName]
    version = values[:version]

    targets.split(",").map(&:strip).each do |target|
      increment_version_number_in_xcodeproj(
        target: target,
        version_number: version,
        build_configuration_name: configName,
      )
    end
  end

  desc "Build Number"
  lane :build_number do |values|
    number = values[:versionBuildNumber].to_i + 1
    puts "Build Number: #{number}"
    number
  end

  desc "Build Tag Name"
  lane :tag_name do |values|
    buildName = values[:buildName]
    buildNumber = values[:buildNumber]
    brand = values[:brand]
    buildType = values[:buildType]
    name = "#{brand}/#{buildType}_#{buildName}_Build=#{buildNumber}"
    puts "Tag Name: #{name}"
    name
  end

  desc "Build Version"
  lane :full_version do |values|
    buildType = values[:buildType]
    buildCode = values[:buildCode]
    date = DateTime.now
    version = "#{date.strftime("%Y.%m")}.#{buildCode}-#{buildType}"
    puts "Generated Calver: #{version}"
    version
  end

  desc "Appstore Build Version"
  lane :minified_version do |values|
    targets = values[:targets]
    configName = values[:configName]
    fullVersion = values[:fullVersion]
    version = fullVersion.split("-").first
    puts "Minified Version For Appstore: #{version}"
    update_version(
      targets: targets,
      configName: configName,
      version: version,
    )
  end
end
